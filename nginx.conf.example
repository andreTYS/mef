# Nginx config para masredespro.com
# Copiar a: /etc/nginx/sites-available/mef-portal
# Luego: ln -s /etc/nginx/sites-available/mef-portal /etc/nginx/sites-enabled/

server {
    listen 80;
    server_name masredespro.com www.masredespro.com;

    # Redirigir todo HTTP → HTTPS
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name masredespro.com www.masredespro.com;

    # Certificado Let's Encrypt (Certbot lo rellena automáticamente)
    ssl_certificate     /etc/letsencrypt/live/masredespro.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/masredespro.com/privkey.pem;
    include             /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam         /etc/letsencrypt/ssl-dhparams.pem;

    # Seguridad
    add_header X-Frame-Options       "SAMEORIGIN"   always;
    add_header X-Content-Type-Options "nosniff"     always;
    add_header Referrer-Policy       "strict-origin" always;

    # Gzip
    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # Proxy hacia Node.js
    location / {
        proxy_pass         http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header   Upgrade $http_upgrade;
        proxy_set_header   Connection 'upgrade';
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;

        # Timeout largo para primera consulta (Playwright tarda ~20s)
        proxy_read_timeout  90s;
        proxy_send_timeout  90s;
        proxy_connect_timeout 10s;
    }

    # Cache de assets estáticos (CSS, JS, imágenes)
    location ~* \.(css|js|png|jpg|svg|ico|woff2?)$ {
        proxy_pass         http://127.0.0.1:3000;
        proxy_set_header   Host $host;
        expires            7d;
        add_header         Cache-Control "public, immutable";
    }
}
